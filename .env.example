# Survivor Royale - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================
# Application
# ===========================
# NOTE: Do NOT set NODE_ENV here. Next.js manages it automatically
# (development for `next dev`, production for `next build`/`next start`)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Survivor Royale"

# ===========================
# Web3 Configuration
# ===========================
# Get your project ID from WalletConnect Cloud: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Blockchain network: Base (Coinbase L2)
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_NETWORK=base

# USDC on Base (Circle official)
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Game treasury address (receives USDC payments for tournament entries, battle pass, etc.)
NEXT_PUBLIC_TREASURY_ADDRESS=

# Contract addresses (will be populated after deployment)
NEXT_PUBLIC_LEADERBOARD_ADDRESS=
NEXT_PUBLIC_RANKED_LEADERBOARD_ADDRESS=
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=

# ===========================
# RPC Providers
# ===========================
# Alchemy: https://dashboard.alchemy.com
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# Infura: https://infura.io
NEXT_PUBLIC_INFURA_API_KEY=your_infura_api_key

# ===========================
# Backend API (Optional)
# ===========================
# Only needed if using centralized backend for leaderboards/matchmaking
NEXT_PUBLIC_API_URL=http://localhost:4000
API_SECRET_KEY=your_secure_api_secret

# ===========================
# Database (Optional - for leaderboards)
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/survivor_royale
REDIS_URL=redis://localhost:6379

# ===========================
# IPFS/Storage
# ===========================
# Pinata for IPFS: https://pinata.cloud
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# NFT.Storage alternative: https://nft.storage
NFT_STORAGE_API_KEY=your_nft_storage_api_key

# ===========================
# Analytics
# ===========================
# Mixpanel: https://mixpanel.com
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Google Analytics (optional)
NEXT_PUBLIC_GA_TRACKING_ID=

# ===========================
# Development Only
# ===========================
# Private key for contract deployment (NEVER commit this)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key

# ===========================
# Feature Flags
# ===========================
NEXT_PUBLIC_ENABLE_WEB3=true
NEXT_PUBLIC_ENABLE_LEADERBOARDS=true
NEXT_PUBLIC_ENABLE_COOP=false
NEXT_PUBLIC_ENABLE_RANKED=false

# ===========================
# Game Configuration
# ===========================
NEXT_PUBLIC_MAX_FPS=60
NEXT_PUBLIC_DEBUG_MODE=false
