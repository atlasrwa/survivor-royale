# Survivor Royale - .gitignore

# ===========================
# Node.js & Dependencies
# ===========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ===========================
# Environment & Secrets
# ===========================
.env
.env.local
.env.*.local
.env.production
*.key
*.pem
secrets/
.secrets/

# Private keys and wallets
*.keystore
wallet.json
mnemonic.txt

# ===========================
# Build Outputs
# ===========================
dist/
build/
out/
.next/
.nuxt/
.cache/

# Game builds
builds/
release/
*.exe
*.dmg
*.app
*.apk
*.aab

# ===========================
# Development
# ===========================
.vscode/
.idea/
*.sublime-*
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.history/

# ===========================
# Game Assets (Large Files)
# ===========================
# Uncomment if not using Git LFS
# assets/raw/
# *.psd
# *.ai
# *.blend
# *.wav
# *.mp3
# *.ogg

# Temporary asset exports
assets/temp/
*.tmp

# ===========================
# Testing & Coverage
# ===========================
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.jest/

# ===========================
# Smart Contracts (Hardhat/Foundry)
# ===========================
cache/
artifacts/
typechain/
typechain-types/
deployments/localhost/

# Keep production deployments
!deployments/mainnet/
!deployments/polygon/
!deployments/arbitrum/

# ===========================
# Logs
# ===========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===========================
# Database & Local Storage
# ===========================
*.db
*.sqlite
*.sqlite3
.data/
db/local/

# ===========================
# OS Files
# ===========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===========================
# Misc
# ===========================
*.orig
.temp/
.tmp/
scratch/
TODO.local.md
notes.txt
*.tsbuildinfo
