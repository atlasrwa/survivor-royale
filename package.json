{
  "name": "survivor-royale",
  "version": "0.0.1-alpha",
  "description": "Skill-based auto-shooter with deep hero customization, 2-player co-op, and Web3 integration",
  "private": true,
  "author": "Survivor Royale Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/survivor-royale.git"
  },
  "keywords": [
    "game",
    "web3",
    "phaser",
    "blockchain",
    "nft",
    "auto-shooter",
    "roguelike"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.ts",
    "contracts:verify": "hardhat verify",
    "mobile:sync": "npx --package=@capacitor/cli@6.2.0 cap sync android",
    "mobile:build": "npm run build && npm run mobile:sync && cd android && JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 ./gradlew assembleDebug --no-daemon",
    "mobile:open": "npx --package=@capacitor/cli@6.2.0 cap open android",
    "sprites": "npx ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' scripts/sprites.ts",
    "sprites:generate": "npx ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' scripts/sprites.ts generate --all",
    "sprites:validate": "npx ts-node --compiler-options '{\"module\":\"commonjs\",\"esModuleInterop\":true}' scripts/sprites.ts validate --all",
    "typechain": "hardhat typechain",
    "prepare": "husky install"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@rainbow-me/rainbowkit": "^2.0.0",
    "@tanstack/react-query": "^5.35.0",
    "ethers": "^6.12.0",
    "next": "^14.2.0",
    "phaser": "^3.80.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "viem": "^2.10.0",
    "wagmi": "^2.9.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "@img/sharp-linux-x64": "^0.33.2",
    "@napi-rs/canvas": "^0.1.62",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@playwright/test": "^1.43.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "hardhat": "^2.22.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.5",
    "sharp": "^0.33.5",
    "spritesheet-js": "^1.1.3",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.12",
    "typechain": "^8.3.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
