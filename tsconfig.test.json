{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "@testing-library/jest-dom"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "jest.config.ts",
    "jest.setup.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "llama.cpp"
  ]
}
